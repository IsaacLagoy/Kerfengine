# Blender v3.x OBJ File
# Vertex positions cover normalized device coordinates (-1 to 1)
v -1.000000 -1.000000 0.000000
v  1.000000 -1.000000 0.000000
v  1.000000  1.000000 0.000000
v -1.000000  1.000000 0.000000

# Texture coordinates (UVs) mapped to 0.0 - 1.0 range
vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000

# Faces mapping vertices (v) and UVs (vt)
f 1/1 2/2 3/3
f 1/1 3/3 4/4
